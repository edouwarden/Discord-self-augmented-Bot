# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Comma or space separated channel IDs where the bot is allowed to listen.
# The bot ignores every message if this is empty.
ALLOWED_CHANNEL_IDS=

# Any OpenAI-compatible chat completions endpoint.
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=cohere/north-mini-code:free
LLM_API_KEY=

# Optional: where the generated program lives.
# GENERATED_CODE_PATH=generated_code.py
